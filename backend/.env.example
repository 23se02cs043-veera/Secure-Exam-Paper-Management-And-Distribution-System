# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-super-secret-key-min-32-chars-production
DEBUG=True

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_exam_db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/secure_exam_db

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars-production
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=604800

# Encryption Master Key (base64 encoded 32 bytes)
MASTER_ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3Qta2V5LW5lZWRzLWNoYW5naW5n

# File Upload
UPLOAD_FOLDER=uploads/papers
MAX_CONTENT_LENGTH=104857600

# Email (SMTP) - Configure for notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@university.edu

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PUBLIC_REGISTRATION_ENABLED=true

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Production
PORT=5000
