{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Run Flask Backend Server",
            "type": "shell",
            "command": "python run.py",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "backend"
            }
        },
        {
            "label": "2. Run Vite Frontend Server",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "frontend"
            }
        },
        {
            "label": "🚀 Start Full Project (Backend + Frontend)",
            "dependsOn": [
                "1. Run Flask Backend Server",
                "2. Run Vite Frontend Server"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "🌐 Deploy to Render Public Cloud (Git Push)",
            "type": "shell",
            "command": "git add . && git commit -m 'Deploy update from VS Code' && git push origin main",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "⚡ Start Local Public Tunnel Website",
            "type": "shell",
            "command": ".\\START_PUBLIC_WEBSITE.bat",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
