{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Start Project (Local Backend + Frontend)",
            "type": "shell",
            "command": "${workspaceFolder}\\RUN_PROJECT.bat",
            "windows": {
                "command": "${workspaceFolder}\\RUN_PROJECT.bat"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            }
        },
        {
            "label": "🌍 Open Live Render Website in Browser",
            "type": "shell",
            "command": "cmd /c start https://secure-exam-frontend.onrender.com",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "🌐 Deploy to Render Public Cloud (Git Push)",
            "type": "shell",
            "command": "git add . && git commit -m \"Deploy update from VS Code\" && git push origin main",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "⚡ Start Local Public Tunnel Website",
            "type": "shell",
            "command": "${workspaceFolder}\\START_PUBLIC_WEBSITE.bat",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
